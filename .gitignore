# Exception: the deployable TinyStories checkpoints are checked in so downstream
# builds are reproducible without re-training.
#   _tinystories_final.pt — n_embd=81 reference SoTA model (valid 0.90, too big for BBC)
#   _n56_full.pt          — n_embd=56 BBC-deployable model  (valid 1.03, used by build/bitnet.uef)
!build/bitnet_quant_tinystories_final.pt
!build/bitnet_quant_n56_full.pt
build/*.sim6502
build/*.apple2
build/*.bbc
build/*_train.log
build/test_harness.*

# Regeneratable filtered/tokenized dataset caches (rebuilt by tinystories.py).
modelling/data/cache/

# Source TinyStories data — too large for git (~2 GB train).
modelling/data/TinyStories-*.txt

